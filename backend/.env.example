# Flask Backend Environment Variables - Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Flask ────────────────────────────────────────────────────────────────────
FLASK_APP=run.py
# 'development' locally, 'production' on Render
FLASK_ENV=development
FLASK_DEBUG=True

# ─── SQLAlchemy Database ──────────────────────────────────────────────────────
# Local SQLite (default):
DATABASE_URL=sqlite:///smartcart.db
# MySQL (optional):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/smartcart_db

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Used for recommendation & analytics. Set to your Atlas SRV connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ACCESS_TOKEN_EXPIRES=86400

# ─── Flask Session ────────────────────────────────────────────────────────────
# Generate a strong random string: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your-flask-secret-key-here

# ─── CORS ─────────────────────────────────────────────────────────────────────
# For production, add your Vercel URL. For local dev, use localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example:
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ─── File Upload ──────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ─── Payment (Demo mode) ─────────────────────────────────────────────────────
# Set PAYMENT_MODE=demo for simulated payments
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
